# Copy this file to .env and replace the placeholders locally.
# Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Panel login (AUTH_SECRET must be at least 32 random characters.)
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_VALUE

# Comma-separated frontend origins. Keep false only for local HTTP development.
APP_ORIGIN=http://localhost:5173
AUTH_COOKIE_SECURE=false
